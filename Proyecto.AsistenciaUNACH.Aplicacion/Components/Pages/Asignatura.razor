@page "/asignaturas"

@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Asignaturas</PageTitle>

<div class="management-page">

    <!-- =====================================================
         CABECERA
         ===================================================== -->

    <div class="management-header">

        <div>
            <h2>Gestión de Asignaturas</h2>
            <p>Administra las asignaturas registradas en el sistema.</p>
        </div>

        <div class="management-header-badge">
            ASIGNATURAS
        </div>

    </div>


    <!-- =====================================================
         ACCIONES
         ===================================================== -->

    <div class="management-actions">

        <button class="btn-management-new"
                @onclick="MostrarFormularioNuevo">
            + Nueva asignatura
        </button>

    </div>


    <!-- =====================================================
         MENSAJE
         ===================================================== -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="management-message">
            @mensaje
        </div>
    }


    <!-- =====================================================
         FORMULARIO
         ===================================================== -->
    @if (mostrarFormulario)
    {
        <div class="management-form-card">

            <h4>
                @(modoEdicion ? "Editar asignatura" : "Nueva asignatura")
            </h4>

            <div class="management-form-grid">

                <div>
                    <label>Código de asignatura</label>

                    <input class="form-control"
                           @bind="asignaturaActual.CodigoAsignatura" />
                </div>

                <div>
                    <label>Nombre de asignatura</label>

                    <input class="form-control"
                           @bind="asignaturaActual.NombreAsignatura" />
                </div>

                <div>
                    <label>Semestre</label>

                    <input class="form-control"
                           @bind="asignaturaActual.Semestre" />
                </div>

            </div>


            <div class="management-form-actions">

                <button class="btn-management-save"
                        @onclick="Guardar">
                    @(modoEdicion ? "Actualizar" : "Guardar")
                </button>

                <button class="btn-management-cancel"
                        @onclick="CancelarFormulario">
                    Cancelar
                </button>

            </div>

        </div>
    }


    <!-- =====================================================
         DETALLE DE LA ASIGNATURA
         APARECE ENCIMA DE LA TABLA
         ===================================================== -->
    @if (mostrarDetalle && asignaturaSeleccionada != null)
    {
        <div class="management-detail-card">

            <!-- CABECERA -->

            <div class="management-detail-header">

                <h4>
                    Detalle de la asignatura
                </h4>

                <button class="management-detail-close"
                        @onclick="CerrarDetalle">
                    CERRAR
                </button>

            </div>


            <!-- INFORMACIÓN DE LA ASIGNATURA -->

            <div class="management-detail-info">

                <div class="management-detail-item">

                    <span>ID asignatura:</span>

                    <strong>
                        @asignaturaSeleccionada.IdAsignatura
                    </strong>

                </div>


                <div class="management-detail-item">

                    <span>Código:</span>

                    <strong>
                        @asignaturaSeleccionada.CodigoAsignatura
                    </strong>

                </div>


                <div class="management-detail-item">

                    <span>Nombre:</span>

                    <strong>
                        @asignaturaSeleccionada.NombreAsignatura
                    </strong>

                </div>

            </div>


            <!-- DOCENTES QUE IMPARTEN LA ASIGNATURA -->

            <div class="management-detail-section">

                <h5>
                    Docentes que imparten esta asignatura
                </h5>


                @if (docentesAsignatura.Count > 0)
                {
                    <div class="management-related-list">

                        <table class="management-related-table">

                            <thead>

                                <tr>

                                    <th>
                                        ID DOCENTE
                                    </th>

                                    <th>
                                        DOCENTE
                                    </th>

                                    <th>
                                        CÉDULA
                                    </th>

                                    <th>
                                        CORREO
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var docente in docentesAsignatura)
                                {
                                    <tr>

                                        <td>
                                            @docente.IdDocente
                                        </td>


                                        <td>
                                            <strong>
                                                @docente.Nombres
                                                @docente.Apellidos
                                            </strong>
                                        </td>


                                        <td>
                                            @docente.Cedula
                                        </td>


                                        <td>
                                            @docente.Correo
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="management-detail-empty">

                        No existen docentes asociados a esta asignatura.

                    </div>
                }

            </div>

        </div>
    }


    <!-- =====================================================
         FILTROS Y TABLA
         ===================================================== -->

    <div class="management-content">

        <div class="management-filter">

            <h5>Filtros</h5>

            <label>Buscar</label>

            <input class="form-control"
                   @bind="textoBusqueda"
                   placeholder="Código o nombre de asignatura..." />

            <button class="btn-management-search"
                    @onclick="Buscar">
                Buscar
            </button>

            <button class="btn-management-clear"
                    @onclick="LimpiarBusqueda">
                Limpiar
            </button>

        </div>


        <!-- =================================================
             TABLA
             ================================================= -->

        <div class="management-table-card">

            @if (cargando)
            {
                <div class="management-empty">

                    <strong>
                        Cargando asignaturas...
                    </strong>

                </div>
            }
            else if (asignaturasFiltradas.Count == 0)
            {
                <div class="management-empty">

                    <strong>
                        No existen asignaturas
                    </strong>

                    <span>
                        No se encontraron registros.
                    </span>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table management-table">

                        <thead>

                            <tr>

                                <th>ID</th>

                                <th>Código</th>

                                <th>Asignatura</th>

                                <th>Semestre</th>

                                <th>Opciones</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var asignatura in asignaturasFiltradas)
                            {
                                <tr>

                                    <td>
                                        @asignatura.IdAsignatura
                                    </td>

                                    <td>
                                        @asignatura.CodigoAsignatura
                                    </td>

                                    <td>

                                        <strong>
                                            @asignatura.NombreAsignatura
                                        </strong>

                                    </td>

                                    <td>
                                        @asignatura.Semestre
                                    </td>


                                    <td class="management-options-cell">

                                        <div class="management-options">

                                            <button class="btn btn-sm btn-light"
                                                    @onclick="() => AlternarMenu(asignatura.IdAsignatura)">
                                                ⋮
                                            </button>


                                            @if (menuAbierto == asignatura.IdAsignatura)
                                            {
                                                <div class="management-options-menu">

                                                    <!-- VER -->

                                                    <button @onclick="() => VerAsignatura(asignatura)">
                                                        Ver
                                                    </button>


                                                    <!-- EDITAR -->

                                                    <button @onclick="() => Editar(asignatura)">
                                                        Editar
                                                    </button>


                                                    <!-- ELIMINAR -->

                                                    <button class="danger-option"
                                                            @onclick="() => MostrarConfirmacionEliminar(asignatura)">
                                                        Eliminar
                                                    </button>

                                                </div>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- =====================================================
     CONFIRMACIÓN DE ELIMINACIÓN
     ===================================================== -->
@if (mostrarConfirmacion)
{
    <div class="confirmation-overlay">

        <div class="confirmation-modal">

            <div class="confirmation-icon">
                !
            </div>


            <h3>
                Confirmar eliminación
            </h3>


            <p>
                ¿Está seguro de que desea eliminar esta asignatura?
            </p>


            @if (asignaturaAEliminar != null)
            {
                <div class="confirmation-detail">

                    <strong>
                        @asignaturaAEliminar.NombreAsignatura
                    </strong>

                    <span>
                        Código:
                        @asignaturaAEliminar.CodigoAsignatura
                    </span>

                </div>
            }


            <p class="confirmation-warning">
                Esta acción no se puede deshacer.
            </p>


            <div class="confirmation-actions">

                <button class="btn-confirmation-cancel"
                        @onclick="CancelarEliminacion">
                    Cancelar
                </button>


                <button class="btn-confirmation-delete"
                        @onclick="ConfirmarEliminacion">
                    Sí, eliminar
                </button>

            </div>

        </div>

    </div>
}


@code {

    // =====================================================
    // LISTAS
    // =====================================================

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
        asignaturas = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
        asignaturasFiltradas = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
        docentes = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
        carreras = new();


    // =====================================================
    // ASIGNATURA ACTUAL
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura
        asignaturaActual = new();


    // =====================================================
    // DETALLE
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura?
        asignaturaSeleccionada;

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
        docentesAsignatura = new();

    private bool mostrarDetalle = false;


    // =====================================================
    // ELIMINACIÓN
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura?
        asignaturaAEliminar;


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool mostrarFormulario = false;

    private bool modoEdicion = false;

    private bool cargando = true;

    private bool mostrarConfirmacion = false;

    private string textoBusqueda = string.Empty;

    private string mensaje = string.Empty;

    private int? menuAbierto = null;


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }


    // =====================================================
    // CARGAR DATOS
    // =====================================================

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;


            asignaturas =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
                >("api/Asignatura")
                ?? new();


            docentes =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
                >("api/Docente")
                ?? new();


            carreras =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
                >("api/Carrera")
                ?? new();


            asignaturasFiltradas =
                asignaturas.ToList();
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // NUEVA ASIGNATURA
    // =====================================================

    private void MostrarFormularioNuevo()
    {
        asignaturaActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura();


        modoEdicion = false;

        mostrarFormulario = true;

        mensaje = string.Empty;

        menuAbierto = null;

        CerrarDetalle();
    }


    // =====================================================
    // VER ASIGNATURA
    // =====================================================

    private void VerAsignatura(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura asignatura)
    {
        asignaturaSeleccionada = asignatura;


        docentesAsignatura =
            docentes
                .Where(d =>
                    d.IdAsignatura ==
                    asignatura.IdAsignatura)
                .ToList();


        mostrarDetalle = true;

        menuAbierto = null;

        mensaje = string.Empty;
    }


    // =====================================================
    // CERRAR DETALLE
    // =====================================================

    private void CerrarDetalle()
    {
        mostrarDetalle = false;

        asignaturaSeleccionada = null;

        docentesAsignatura =
            new();
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void Editar(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura asignatura)
    {
        asignaturaActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura
            {
                IdAsignatura =
                    asignatura.IdAsignatura,

                CodigoAsignatura =
                    asignatura.CodigoAsignatura,

                NombreAsignatura =
                    asignatura.NombreAsignatura,

                Semestre =
                    asignatura.Semestre
            };


        modoEdicion = true;

        mostrarFormulario = true;

        menuAbierto = null;

        mensaje = string.Empty;

        CerrarDetalle();
    }


    // =====================================================
    // GUARDAR
    // =====================================================

    private async Task Guardar()
    {
        try
        {
            if (modoEdicion)
            {
                var response =
                    await Http.PutAsJsonAsync(
                        $"api/Asignatura/{asignaturaActual.IdAsignatura}",
                        asignaturaActual);


                if (response.IsSuccessStatusCode)
                {
                    mensaje =
                        "Asignatura actualizada correctamente.";
                }
                else
                {
                    mensaje =
                        "No se pudo actualizar la asignatura.";

                    return;
                }
            }
            else
            {
                var response =
                    await Http.PostAsJsonAsync(
                        "api/Asignatura",
                        asignaturaActual);


                if (response.IsSuccessStatusCode)
                {
                    mensaje =
                        "Asignatura creada correctamente.";
                }
                else
                {
                    mensaje =
                        "No se pudo crear la asignatura.";

                    return;
                }
            }


            mostrarFormulario = false;

            await CargarDatos();
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error: {ex.Message}";
        }
    }


    // =====================================================
    // CANCELAR FORMULARIO
    // =====================================================

    private void CancelarFormulario()
    {
        mostrarFormulario = false;

        asignaturaActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura();

        mensaje = string.Empty;
    }


    // =====================================================
    // MOSTRAR CONFIRMACIÓN
    // =====================================================

    private void MostrarConfirmacionEliminar(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura asignatura)
    {
        asignaturaAEliminar = asignatura;

        mostrarConfirmacion = true;

        menuAbierto = null;

        CerrarDetalle();
    }


    // =====================================================
    // CANCELAR ELIMINACIÓN
    // =====================================================

    private void CancelarEliminacion()
    {
        mostrarConfirmacion = false;

        asignaturaAEliminar = null;
    }


    // =====================================================
    // CONFIRMAR ELIMINACIÓN
    // =====================================================

    private async Task ConfirmarEliminacion()
    {
        if (asignaturaAEliminar == null)
            return;


        try
        {
            var id =
                asignaturaAEliminar.IdAsignatura;


            var response =
                await Http.DeleteAsync(
                    $"api/Asignatura/{id}");


            if (response.IsSuccessStatusCode)
            {
                mensaje =
                    "Asignatura eliminada correctamente.";


                mostrarConfirmacion = false;

                asignaturaAEliminar = null;


                await CargarDatos();
            }
            else
            {
                mensaje =
                    "No se pudo eliminar la asignatura.";
            }
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error: {ex.Message}";
        }
    }


    // =====================================================
    // MENÚ
    // =====================================================

    private void AlternarMenu(int id)
    {
        if (menuAbierto == id)
        {
            menuAbierto = null;
        }
        else
        {
            menuAbierto = id;
        }
    }


    // =====================================================
    // BUSCAR
    // =====================================================

    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            asignaturasFiltradas =
                asignaturas.ToList();

            return;
        }


        var texto =
            textoBusqueda.Trim().ToLower();


        asignaturasFiltradas =
            asignaturas
                .Where(a =>
                    (a.CodigoAsignatura ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (a.NombreAsignatura ?? "")
                        .ToLower()
                        .Contains(texto))
                .ToList();
    }


    // =====================================================
    // LIMPIAR BÚSQUEDA
    // =====================================================

    private void LimpiarBusqueda()
    {
        textoBusqueda =
            string.Empty;


        asignaturasFiltradas =
            asignaturas.ToList();
    }


    // =====================================================
    // OBTENER CARRERA
    // =====================================================

    private string ObtenerNombreCarrera(int idCarrera)
    {
        var carrera =
            carreras.FirstOrDefault(
                c => c.IdCarrera == idCarrera);


        return carrera?.NombreCarrera
            ?? "Sin carrera";
    }

}