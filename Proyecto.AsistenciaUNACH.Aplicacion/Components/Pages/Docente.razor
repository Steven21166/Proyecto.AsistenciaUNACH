@page "/docentes"

@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Docentes</PageTitle>

<div class="management-page">

    <!-- =====================================================
         CABECERA
         ===================================================== -->

    <div class="management-header">

        <div>
            <h2>Gestión de Docentes</h2>
            <p>Administra los docentes registrados en el sistema.</p>
        </div>

        <div class="management-header-badge">
            DOCENTES
        </div>

    </div>


    <!-- =====================================================
         ACCIONES
         ===================================================== -->

    <div class="management-actions">

        <button class="btn-management-new"
                @onclick="MostrarFormularioNuevo">
            + Nuevo docente
        </button>

    </div>


    <!-- =====================================================
         MENSAJE
         ===================================================== -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="management-message">
            @mensaje
        </div>
    }


    <!-- =====================================================
         FORMULARIO
         ===================================================== -->
    @if (mostrarFormulario)
    {
        <div class="management-form-card">

            <h4>
                @(modoEdicion ? "Editar docente" : "Nuevo docente")
            </h4>

            <div class="management-form-grid">

                <div>
                    <label>Nombres</label>

                    <input class="form-control"
                           @bind="docenteActual.Nombres" />
                </div>

                <div>
                    <label>Apellidos</label>

                    <input class="form-control"
                           @bind="docenteActual.Apellidos" />
                </div>

                <div>
                    <label>Cédula</label>

                    <input class="form-control"
                           @bind="docenteActual.Cedula" />
                </div>

                <div>
                    <label>Celular</label>

                    <input class="form-control"
                           @bind="docenteActual.Celular" />
                </div>

                <div>
                    <label>Correo</label>

                    <input type="email"
                           class="form-control"
                           @bind="docenteActual.Correo" />
                </div>

                <div>
                    <label>Carrera</label>

                    <select class="form-control"
                            @bind="docenteActual.IdCarrera">

                        <option value="0">
                            Seleccione una carrera
                        </option>

                        @foreach (var carrera in carreras)
                        {
                            <option value="@carrera.IdCarrera">
                                @carrera.NombreCarrera
                            </option>
                        }

                    </select>
                </div>

                <div>
                    <label>Asignatura</label>

                    <select class="form-control"
                            @bind="docenteActual.IdAsignatura">

                        <option value="0">
                            Seleccione una asignatura
                        </option>

                        @foreach (var asignatura in asignaturas)
                        {
                            <option value="@asignatura.IdAsignatura">
                                @asignatura.NombreAsignatura
                            </option>
                        }

                    </select>
                </div>

                <div>
                    <label>Fecha de asistencia</label>

                    <input type="date"
                           class="form-control"
                           @bind="docenteActual.FechaAsistencia" />
                </div>

                <div>
                    <label>Hora de entrada</label>

                    <input type="time"
                           class="form-control"
                           @bind="docenteActual.HoraEntrada" />
                </div>

                <div>
                    <label>Hora de salida</label>

                    <input type="time"
                           class="form-control"
                           @bind="docenteActual.HoraSalida" />
                </div>

                <div>
                    <label>Estado de asistencia</label>

                    <select class="form-control"
                            @bind="docenteActual.EstadoAsistencia">

                        <option value="">
                            Seleccione un estado
                        </option>

                        <option value="Presente">
                            Presente
                        </option>

                        <option value="Atraso">
                            Atraso
                        </option>

                        <option value="Ausente">
                            Ausente
                        </option>

                        <option value="Justificado">
                            Justificado
                        </option>

                    </select>
                </div>

            </div>


            <div class="management-form-actions">

                <button class="btn-management-save"
                        @onclick="Guardar">
                    @(modoEdicion ? "Actualizar" : "Guardar")
                </button>

                <button class="btn-management-cancel"
                        @onclick="CancelarFormulario">
                    Cancelar
                </button>

            </div>

        </div>
    }


    <!-- =====================================================
         DETALLE DEL DOCENTE
         APARECE ENCIMA DE LA TABLA
         ===================================================== -->
    @if (mostrarDetalle && docenteSeleccionado != null)
    {
        <div class="management-detail-card">

            <div class="management-detail-header">

                <h4>
                    Detalle del docente
                </h4>

                <button class="management-detail-close"
                        @onclick="CerrarDetalle">
                    CERRAR
                </button>

            </div>


            <div class="management-detail-info">

                <div class="management-detail-item">
                    <span>ID docente:</span>

                    <strong>
                        @docenteSeleccionado.IdDocente
                    </strong>
                </div>


                <div class="management-detail-item">
                    <span>Docente:</span>

                    <strong>
                        @docenteSeleccionado.Nombres
                        @docenteSeleccionado.Apellidos
                    </strong>
                </div>


                <div class="management-detail-item">
                    <span>Cédula:</span>

                    <strong>
                        @docenteSeleccionado.Cedula
                    </strong>
                </div>


                <div class="management-detail-item">
                    <span>Celular:</span>

                    <strong>
                        @docenteSeleccionado.Celular
                    </strong>
                </div>


                <div class="management-detail-item">
                    <span>Correo:</span>

                    <strong>
                        @docenteSeleccionado.Correo
                    </strong>
                </div>


                <div class="management-detail-item">
                    <span>Carrera:</span>

                    <strong>
                        @ObtenerNombreCarrera(
                            docenteSeleccionado.IdCarrera)
                    </strong>
                </div>


                <div class="management-detail-item">
                    <span>Asignatura:</span>

                    <strong>
                        @ObtenerNombreAsignatura(
                            docenteSeleccionado.IdAsignatura)
                    </strong>
                </div>

            </div>


            <div class="management-detail-section">

                <h5>
                    Información de asistencia
                </h5>

                <div class="management-detail-info">

                    <div class="management-detail-item">
                        <span>Fecha:</span>

                        <strong>
                            @docenteSeleccionado.FechaAsistencia
                        </strong>
                    </div>


                    <div class="management-detail-item">
                        <span>Hora de entrada:</span>

                        <strong>
                            @docenteSeleccionado.HoraEntrada
                        </strong>
                    </div>


                    <div class="management-detail-item">
                        <span>Hora de salida:</span>

                        <strong>
                            @docenteSeleccionado.HoraSalida
                        </strong>
                    </div>


                    <div class="management-detail-item">
                        <span>Estado:</span>

                        <strong>
                            @docenteSeleccionado.EstadoAsistencia
                        </strong>
                    </div>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         FILTROS Y TABLA
         ===================================================== -->

    <div class="management-content">

        <div class="management-filter">

            <h5>Filtros</h5>

            <label>Buscar</label>

            <input class="form-control"
                   @bind="textoBusqueda"
                   placeholder="Cédula, nombres, apellidos o correo..." />

            <button class="btn-management-search"
                    @onclick="Buscar">
                Buscar
            </button>

            <button class="btn-management-clear"
                    @onclick="LimpiarBusqueda">
                Limpiar
            </button>

        </div>


        <div class="management-table-card">

            @if (cargando)
            {
                <div class="management-empty">

                    <strong>
                        Cargando docentes...
                    </strong>

                </div>
            }
            else if (docentesFiltrados.Count == 0)
            {
                <div class="management-empty">

                    <strong>
                        No existen docentes
                    </strong>

                    <span>
                        No se encontraron registros.
                    </span>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table management-table">

                        <thead>

                            <tr>

                                <th>ID</th>

                                <th>Docente</th>

                                <th>Cédula</th>

                                <th>Correo</th>

                                <th>Carrera</th>

                                <th>Asignatura</th>

                                <th>Asistencia</th>

                                <th>Opciones</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var docente in docentesFiltrados)
                            {
                                <tr>

                                    <td>
                                        @docente.IdDocente
                                    </td>

                                    <td>
                                        <strong>
                                            @docente.Nombres
                                            @docente.Apellidos
                                        </strong>
                                    </td>

                                    <td>
                                        @docente.Cedula
                                    </td>

                                    <td>
                                        @docente.Correo
                                    </td>

                                    <td>
                                        @ObtenerNombreCarrera(
                                            docente.IdCarrera)
                                    </td>

                                    <td>
                                        @ObtenerNombreAsignatura(
                                            docente.IdAsignatura)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            docente.EstadoAsistencia)
                                            ? "Sin registro"
                                            : docente.EstadoAsistencia)
                                    </td>

                                    <td class="management-options-cell">

                                        <div class="management-options">

                                            <button class="btn btn-sm btn-light"
                                                    @onclick="() => AlternarMenu(docente.IdDocente)">
                                                ⋮
                                            </button>

                                            @if (menuAbierto == docente.IdDocente)
                                            {
                                                <div class="management-options-menu">

                                                    <!-- NUEVA OPCIÓN VER -->

                                                    <button @onclick="() => VerDocente(docente)">
                                                        Ver
                                                    </button>


                                                    <!-- EDITAR -->

                                                    <button @onclick="() => Editar(docente)">
                                                        Editar
                                                    </button>


                                                    <!-- ELIMINAR -->

                                                    <button class="danger-option"
                                                            @onclick="() => MostrarConfirmacionEliminar(docente)">
                                                        Eliminar
                                                    </button>

                                                </div>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- =====================================================
     CONFIRMACIÓN DE ELIMINACIÓN
     ===================================================== -->
@if (mostrarConfirmacion)
{
    <div class="confirmation-overlay">

        <div class="confirmation-modal">

            <div class="confirmation-icon">
                !
            </div>

            <h3>
                Confirmar eliminación
            </h3>

            <p>
                ¿Está seguro de que desea eliminar este docente?
            </p>

            @if (docenteAEliminar != null)
            {
                <div class="confirmation-detail">

                    <strong>
                        @docenteAEliminar.Nombres
                        @docenteAEliminar.Apellidos
                    </strong>

                    <span>
                        Cédula: @docenteAEliminar.Cedula
                    </span>

                </div>
            }

            <p class="confirmation-warning">
                Esta acción no se puede deshacer.
            </p>

            <div class="confirmation-actions">

                <button class="btn-confirmation-cancel"
                        @onclick="CancelarEliminacion">
                    Cancelar
                </button>

                <button class="btn-confirmation-delete"
                        @onclick="ConfirmarEliminacion">
                    Sí, eliminar
                </button>

            </div>

        </div>

    </div>
}


@code {

    // =====================================================
    // LISTAS
    // =====================================================

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
        docentes = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
        docentesFiltrados = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
        carreras = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
        asignaturas = new();


    // =====================================================
    // DOCENTE ACTUAL
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente
        docenteActual = new();


    // =====================================================
    // DETALLE
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente?
        docenteSeleccionado;

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura?
        asignaturaDocente;

    private bool mostrarDetalle = false;


    // =====================================================
    // ELIMINACIÓN
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente?
        docenteAEliminar;


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool mostrarFormulario = false;

    private bool modoEdicion = false;

    private bool cargando = true;

    private bool mostrarConfirmacion = false;

    private string textoBusqueda = string.Empty;

    private string mensaje = string.Empty;

    private int? menuAbierto = null;


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }


    // =====================================================
    // CARGAR DATOS
    // =====================================================

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;

            docentes =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
                >("api/Docente")
                ?? new();

            carreras =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
                >("api/Carrera")
                ?? new();

            asignaturas =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
                >("api/Asignatura")
                ?? new();

            docentesFiltrados =
                docentes.ToList();
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // MOSTRAR FORMULARIO NUEVO
    // =====================================================

    private void MostrarFormularioNuevo()
    {
        docenteActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente();

        modoEdicion = false;

        mostrarFormulario = true;

        mensaje = string.Empty;

        menuAbierto = null;

        CerrarDetalle();
    }


    // =====================================================
    // VER DOCENTE
    // =====================================================

    private void VerDocente(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente docente)
    {
        docenteSeleccionado = docente;

        asignaturaDocente =
            asignaturas.FirstOrDefault(
                a => a.IdAsignatura == docente.IdAsignatura);

        mostrarDetalle = true;

        menuAbierto = null;

        mensaje = string.Empty;
    }


    // =====================================================
    // CERRAR DETALLE
    // =====================================================

    private void CerrarDetalle()
    {
        mostrarDetalle = false;

        docenteSeleccionado = null;

        asignaturaDocente = null;
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void Editar(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente docente)
    {
        docenteActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente
            {
                IdDocente = docente.IdDocente,
                Nombres = docente.Nombres,
                Apellidos = docente.Apellidos,
                Cedula = docente.Cedula,
                Celular = docente.Celular,
                Correo = docente.Correo,
                IdCarrera = docente.IdCarrera,
                IdAsignatura = docente.IdAsignatura,
                FechaAsistencia = docente.FechaAsistencia,
                HoraEntrada = docente.HoraEntrada,
                HoraSalida = docente.HoraSalida,
                EstadoAsistencia = docente.EstadoAsistencia
            };

        modoEdicion = true;

        mostrarFormulario = true;

        menuAbierto = null;

        mensaje = string.Empty;

        CerrarDetalle();
    }


    // =====================================================
    // GUARDAR
    // =====================================================

    private async Task Guardar()
    {
        try
        {
            if (modoEdicion)
            {
                var response =
                    await Http.PutAsJsonAsync(
                        $"api/Docente/{docenteActual.IdDocente}",
                        docenteActual);

                if (response.IsSuccessStatusCode)
                {
                    mensaje =
                        "Docente actualizado correctamente.";
                }
                else
                {
                    mensaje =
                        "No se pudo actualizar el docente.";

                    return;
                }
            }
            else
            {
                var response =
                    await Http.PostAsJsonAsync(
                        "api/Docente",
                        docenteActual);

                if (response.IsSuccessStatusCode)
                {
                    mensaje =
                        "Docente creado correctamente.";
                }
                else
                {
                    mensaje =
                        "No se pudo crear el docente.";

                    return;
                }
            }

            mostrarFormulario = false;

            await CargarDatos();
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error: {ex.Message}";
        }
    }


    // =====================================================
    // CANCELAR FORMULARIO
    // =====================================================

    private void CancelarFormulario()
    {
        mostrarFormulario = false;

        docenteActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente();

        mensaje = string.Empty;
    }


    // =====================================================
    // MOSTRAR CONFIRMACIÓN
    // =====================================================

    private void MostrarConfirmacionEliminar(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente docente)
    {
        docenteAEliminar = docente;

        mostrarConfirmacion = true;

        menuAbierto = null;

        CerrarDetalle();
    }


    // =====================================================
    // CANCELAR ELIMINACIÓN
    // =====================================================

    private void CancelarEliminacion()
    {
        mostrarConfirmacion = false;

        docenteAEliminar = null;
    }


    // =====================================================
    // CONFIRMAR ELIMINACIÓN
    // =====================================================

    private async Task ConfirmarEliminacion()
    {
        if (docenteAEliminar == null)
            return;

        try
        {
            var id =
                docenteAEliminar.IdDocente;

            var response =
                await Http.DeleteAsync(
                    $"api/Docente/{id}");

            if (response.IsSuccessStatusCode)
            {
                mensaje =
                    "Docente eliminado correctamente.";

                mostrarConfirmacion = false;

                docenteAEliminar = null;

                await CargarDatos();
            }
            else
            {
                mensaje =
                    "No se pudo eliminar el docente.";
            }
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error: {ex.Message}";
        }
    }


    // =====================================================
    // MENÚ DE OPCIONES
    // =====================================================

    private void AlternarMenu(int id)
    {
        if (menuAbierto == id)
        {
            menuAbierto = null;
        }
        else
        {
            menuAbierto = id;
        }
    }


    // =====================================================
    // BUSCAR
    // =====================================================

    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            docentesFiltrados =
                docentes.ToList();

            return;
        }

        var texto =
            textoBusqueda.Trim().ToLower();

        docentesFiltrados =
            docentes
                .Where(d =>
                    (d.Cedula ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (d.Nombres ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (d.Apellidos ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (d.Correo ?? "")
                        .ToLower()
                        .Contains(texto))
                .ToList();
    }


    // =====================================================
    // LIMPIAR BÚSQUEDA
    // =====================================================

    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        docentesFiltrados =
            docentes.ToList();
    }


    // =====================================================
    // OBTENER CARRERA
    // =====================================================

    private string ObtenerNombreCarrera(int idCarrera)
    {
        var carrera =
            carreras.FirstOrDefault(
                c => c.IdCarrera == idCarrera);

        return carrera?.NombreCarrera
            ?? "Sin carrera";
    }


    // =====================================================
    // OBTENER ASIGNATURA
    // =====================================================

    private string ObtenerNombreAsignatura(int idAsignatura)
    {
        var asignatura =
            asignaturas.FirstOrDefault(
                a => a.IdAsignatura == idAsignatura);

        return asignatura?.NombreAsignatura
            ?? "Sin asignatura";
    }

}