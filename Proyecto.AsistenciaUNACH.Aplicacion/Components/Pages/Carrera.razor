@page "/carreras"

@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Carreras</PageTitle>

<div class="management-page">

    <!-- =====================================================
         CABECERA
         ===================================================== -->

    <div class="management-header">

        <div>
            <h2>Gestión de Carreras</h2>
            <p>Administra las carreras registradas en el sistema.</p>
        </div>

        <div class="management-header-badge">
            CARRERAS
        </div>

    </div>


    <!-- =====================================================
         ACCIONES
         ===================================================== -->

    <div class="management-actions">

        <button class="btn-management-new"
                @onclick="MostrarFormularioNuevo">
            + Nueva carrera
        </button>

    </div>


    <!-- =====================================================
         MENSAJE
         ===================================================== -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="management-message">
            @mensaje
        </div>
    }


    <!-- =====================================================
         FORMULARIO
         ===================================================== -->
    @if (mostrarFormulario)
    {
        <div class="management-form-card">

            <h4>
                @(modoEdicion ? "Editar carrera" : "Nueva carrera")
            </h4>

            <div class="management-form-grid">

                <!-- CÓDIGO -->

                <div>
                    <label>Código de carrera</label>

                    <input class="form-control"
                           @bind="carreraActual.CodigoCarrera" />
                </div>


                <!-- NOMBRE -->

                <div>
                    <label>Nombre de carrera</label>

                    <input class="form-control"
                           @bind="carreraActual.NombreCarrera" />
                </div>


                <!-- FACULTAD -->

                <div>
                    <label>Facultad</label>

                    <input class="form-control"
                           @bind="carreraActual.Facultad" />
                </div>


                <!-- MODALIDAD -->

                <div>
                    <label>Modalidad</label>

                    <select class="form-control"
                            @bind="carreraActual.Modalidad">

                        <option value="">
                            Seleccione una modalidad
                        </option>

                        <option value="Presencial">
                            Presencial
                        </option>

                        <option value="Virtual">
                            Virtual
                        </option>

                        <option value="Híbrida">
                            Híbrida
                        </option>

                    </select>

                </div>

            </div>


            <!-- BOTONES -->

            <div class="management-form-actions">

                <button class="btn-management-save"
                        @onclick="Guardar">
                    @(modoEdicion ? "Actualizar" : "Guardar")
                </button>

                <button class="btn-management-cancel"
                        @onclick="CancelarFormulario">
                    Cancelar
                </button>

            </div>

        </div>
    }


    <!-- =====================================================
         DETALLE DE LA CARRERA
         APARECE ENCIMA DE LA TABLA
         ===================================================== -->
    @if (mostrarDetalle && carreraSeleccionada != null)
    {
        <div class="management-detail-card">

            <!-- =================================================
             CABECERA
             ================================================= -->

            <div class="management-detail-header">

                <h4>
                    Detalle de la carrera
                </h4>

                <button class="management-detail-close"
                        @onclick="CerrarDetalle">
                    CERRAR
                </button>

            </div>


            <!-- =================================================
             INFORMACIÓN DE LA CARRERA
             ================================================= -->

            <div class="management-detail-info">

                <div class="management-detail-item">

                    <span>ID carrera:</span>

                    <strong>
                        @carreraSeleccionada.IdCarrera
                    </strong>

                </div>


                <div class="management-detail-item">

                    <span>Nombre:</span>

                    <strong>
                        @carreraSeleccionada.NombreCarrera
                    </strong>

                </div>


                <div class="management-detail-item">

                    <span>Facultad:</span>

                    <strong>
                        @carreraSeleccionada.Facultad
                    </strong>

                </div>


                <div class="management-detail-item">

                    <span>Modalidad:</span>

                    <strong>
                        @carreraSeleccionada.Modalidad
                    </strong>

                </div>

            </div>


            <!-- =================================================
             DOCENTES
             ================================================= -->

            <div class="management-detail-section">

                <h5>
                    Docentes
                </h5>


                @if (docentesCarrera.Count > 0)
                {
                    <div class="management-related-list">

                        <table class="management-related-table">

                            <thead>

                                <tr>

                                    <th>
                                        ID DOCENTE
                                    </th>

                                    <th>
                                        DOCENTE
                                    </th>

                                    <th>
                                        CÉDULA
                                    </th>

                                    <th>
                                        ASIGNATURA
                                    </th>

                                    <th>
                                        CORREO
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var docente in docentesCarrera)
                                {
                                    <tr>

                                        <td>
                                            @docente.IdDocente
                                        </td>


                                        <td>
                                            <strong>
                                                @docente.Nombres
                                                @docente.Apellidos
                                            </strong>
                                        </td>


                                        <td>
                                            @docente.Cedula
                                        </td>


                                        <td>
                                            @ObtenerNombreAsignatura(
                                                docente.IdAsignatura)
                                        </td>


                                        <td>
                                            @docente.Correo
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="management-detail-empty">

                        No existen docentes asociados a esta carrera.

                    </div>
                }

            </div>

        </div>
    }


    <!-- =====================================================
         FILTROS Y TABLA
         ===================================================== -->

    <div class="management-content">

        <!-- FILTROS -->

        <div class="management-filter">

            <h5>
                Filtros
            </h5>


            <label>
                Buscar
            </label>


            <input class="form-control"
                   @bind="textoBusqueda"
                   placeholder="Código, nombre o facultad..." />


            <button class="btn-management-search"
                    @onclick="Buscar">
                Buscar
            </button>


            <button class="btn-management-clear"
                    @onclick="LimpiarBusqueda">
                Limpiar
            </button>

        </div>


        <!-- =================================================
             TABLA
             ================================================= -->

        <div class="management-table-card">

            @if (cargando)
            {
                <div class="management-empty">

                    <strong>
                        Cargando carreras...
                    </strong>

                </div>
            }
            else if (carrerasFiltradas.Count == 0)
            {
                <div class="management-empty">

                    <strong>
                        No existen carreras
                    </strong>

                    <span>
                        No se encontraron registros.
                    </span>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table management-table">

                        <thead>

                            <tr>

                                <th>ID</th>

                                <th>Código</th>

                                <th>Carrera</th>

                                <th>Facultad</th>

                                <th>Modalidad</th>

                                <th>Opciones</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var carrera in carrerasFiltradas)
                            {
                                <tr>

                                    <td>
                                        @carrera.IdCarrera
                                    </td>


                                    <td>
                                        @carrera.CodigoCarrera
                                    </td>


                                    <td>

                                        <strong>
                                            @carrera.NombreCarrera
                                        </strong>

                                    </td>


                                    <td>
                                        @carrera.Facultad
                                    </td>


                                    <td>
                                        @carrera.Modalidad
                                    </td>


                                    <td class="management-options-cell">

                                        <div class="management-options">

                                            <button class="btn btn-sm btn-light"
                                                    @onclick="() => AlternarMenu(carrera.IdCarrera)">
                                                ⋮
                                            </button>


                                            @if (menuAbierto == carrera.IdCarrera)
                                            {
                                                <div class="management-options-menu">

                                                    <!-- VER -->

                                                    <button @onclick="() => VerCarrera(carrera)">
                                                        Ver
                                                    </button>


                                                    <!-- EDITAR -->

                                                    <button @onclick="() => Editar(carrera)">
                                                        Editar
                                                    </button>


                                                    <!-- ELIMINAR -->

                                                    <button class="danger-option"
                                                            @onclick="() => MostrarConfirmacionEliminar(carrera)">
                                                        Eliminar
                                                    </button>

                                                </div>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- =====================================================
     CONFIRMACIÓN DE ELIMINACIÓN
     ===================================================== -->
@if (mostrarConfirmacion)
{
    <div class="confirmation-overlay">

        <div class="confirmation-modal">

            <div class="confirmation-icon">
                !
            </div>


            <h3>
                Confirmar eliminación
            </h3>


            <p>
                ¿Está seguro de que desea eliminar esta carrera?
            </p>


            @if (carreraAEliminar != null)
            {
                <div class="confirmation-detail">

                    <strong>
                        @carreraAEliminar.NombreCarrera
                    </strong>

                    <span>
                        Código:
                        @carreraAEliminar.CodigoCarrera
                    </span>

                </div>
            }


            <p class="confirmation-warning">
                Esta acción no se puede deshacer.
            </p>


            <div class="confirmation-actions">

                <button class="btn-confirmation-cancel"
                        @onclick="CancelarEliminacion">
                    Cancelar
                </button>


                <button class="btn-confirmation-delete"
                        @onclick="ConfirmarEliminacion">
                    Sí, eliminar
                </button>

            </div>

        </div>

    </div>
}


@code {

    // =====================================================
    // LISTAS
    // =====================================================

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
        carreras = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
        carrerasFiltradas = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
        docentes = new();

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
        asignaturas = new();


    // =====================================================
    // CARRERA ACTUAL
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera
        carreraActual = new();


    // =====================================================
    // DETALLE
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera?
        carreraSeleccionada;

    private List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
        docentesCarrera = new();

    private bool mostrarDetalle = false;


    // =====================================================
    // ELIMINACIÓN
    // =====================================================

    private Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera?
        carreraAEliminar;


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool mostrarFormulario = false;

    private bool modoEdicion = false;

    private bool cargando = true;

    private bool mostrarConfirmacion = false;

    private string textoBusqueda = string.Empty;

    private string mensaje = string.Empty;

    private int? menuAbierto = null;


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }


    // =====================================================
    // CARGAR DATOS
    // =====================================================

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;


            carreras =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera>
                >("api/Carrera")
                ?? new();


            docentes =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Docente>
                >("api/Docente")
                ?? new();


            asignaturas =
                await Http.GetFromJsonAsync<
                    List<Proyecto.AsistenciaUNACH.Aplicacion.Models.Asignatura>
                >("api/Asignatura")
                ?? new();


            carrerasFiltradas =
                carreras.ToList();
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // NUEVA CARRERA
    // =====================================================

    private void MostrarFormularioNuevo()
    {
        carreraActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera();


        modoEdicion = false;

        mostrarFormulario = true;

        mensaje = string.Empty;

        menuAbierto = null;

        CerrarDetalle();
    }


    // =====================================================
    // VER CARRERA
    // =====================================================

    private void VerCarrera(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera carrera)
    {
        carreraSeleccionada = carrera;


        docentesCarrera =
            docentes
                .Where(d =>
                    d.IdCarrera ==
                    carrera.IdCarrera)
                .ToList();


        mostrarDetalle = true;

        menuAbierto = null;

        mensaje = string.Empty;
    }


    // =====================================================
    // CERRAR DETALLE
    // =====================================================

    private void CerrarDetalle()
    {
        mostrarDetalle = false;

        carreraSeleccionada = null;

        docentesCarrera =
            new();
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void Editar(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera carrera)
    {
        carreraActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera
            {
                IdCarrera =
                    carrera.IdCarrera,

                CodigoCarrera =
                    carrera.CodigoCarrera,

                NombreCarrera =
                    carrera.NombreCarrera,

                Facultad =
                    carrera.Facultad,

                Modalidad =
                    carrera.Modalidad
            };


        modoEdicion = true;

        mostrarFormulario = true;

        menuAbierto = null;

        mensaje = string.Empty;

        CerrarDetalle();
    }


    // =====================================================
    // GUARDAR
    // =====================================================

    private async Task Guardar()
    {
        try
        {
            if (modoEdicion)
            {
                var response =
                    await Http.PutAsJsonAsync(
                        $"api/Carrera/{carreraActual.IdCarrera}",
                        carreraActual);


                if (response.IsSuccessStatusCode)
                {
                    mensaje =
                        "Carrera actualizada correctamente.";
                }
                else
                {
                    mensaje =
                        "No se pudo actualizar la carrera.";

                    return;
                }
            }
            else
            {
                var response =
                    await Http.PostAsJsonAsync(
                        "api/Carrera",
                        carreraActual);


                if (response.IsSuccessStatusCode)
                {
                    mensaje =
                        "Carrera creada correctamente.";
                }
                else
                {
                    mensaje =
                        "No se pudo crear la carrera.";

                    return;
                }
            }


            mostrarFormulario = false;

            await CargarDatos();
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error: {ex.Message}";
        }
    }


    // =====================================================
    // CANCELAR FORMULARIO
    // =====================================================

    private void CancelarFormulario()
    {
        mostrarFormulario = false;

        carreraActual =
            new Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera();

        mensaje = string.Empty;
    }


    // =====================================================
    // MOSTRAR CONFIRMACIÓN
    // =====================================================

    private void MostrarConfirmacionEliminar(
        Proyecto.AsistenciaUNACH.Aplicacion.Models.Carrera carrera)
    {
        carreraAEliminar = carrera;

        mostrarConfirmacion = true;

        menuAbierto = null;

        CerrarDetalle();
    }


    // =====================================================
    // CANCELAR ELIMINACIÓN
    // =====================================================

    private void CancelarEliminacion()
    {
        mostrarConfirmacion = false;

        carreraAEliminar = null;
    }


    // =====================================================
    // CONFIRMAR ELIMINACIÓN
    // =====================================================

    private async Task ConfirmarEliminacion()
    {
        if (carreraAEliminar == null)
            return;


        try
        {
            var id =
                carreraAEliminar.IdCarrera;


            var response =
                await Http.DeleteAsync(
                    $"api/Carrera/{id}");


            if (response.IsSuccessStatusCode)
            {
                mensaje =
                    "Carrera eliminada correctamente.";


                mostrarConfirmacion = false;

                carreraAEliminar = null;


                await CargarDatos();
            }
            else
            {
                mensaje =
                    "No se pudo eliminar la carrera.";
            }
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error: {ex.Message}";
        }
    }


    // =====================================================
    // MENÚ
    // =====================================================

    private void AlternarMenu(int id)
    {
        if (menuAbierto == id)
        {
            menuAbierto = null;
        }
        else
        {
            menuAbierto = id;
        }
    }


    // =====================================================
    // BUSCAR
    // =====================================================

    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            carrerasFiltradas =
                carreras.ToList();

            return;
        }


        var texto =
            textoBusqueda.Trim().ToLower();


        carrerasFiltradas =
            carreras
                .Where(c =>
                    (c.CodigoCarrera ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (c.NombreCarrera ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (c.Facultad ?? "")
                        .ToLower()
                        .Contains(texto)
                    ||
                    (c.Modalidad ?? "")
                        .ToLower()
                        .Contains(texto))
                .ToList();
    }


    // =====================================================
    // LIMPIAR BÚSQUEDA
    // =====================================================

    private void LimpiarBusqueda()
    {
        textoBusqueda =
            string.Empty;


        carrerasFiltradas =
            carreras.ToList();
    }


    // =====================================================
    // OBTENER ASIGNATURA
    // =====================================================

    private string ObtenerNombreAsignatura(int idAsignatura)
    {
        var asignatura =
            asignaturas.FirstOrDefault(
                a => a.IdAsignatura == idAsignatura);


        return asignatura?.NombreAsignatura
            ?? "Sin asignatura";
    }

}